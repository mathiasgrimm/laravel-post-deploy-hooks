{
    "name": "mathiasgrimm/laravel-post-deploy-hooks",
    "description": "Queue deployment hooks until a Laravel worker is running the expected release.",
    "keywords": ["laravel", "laravel-cloud", "deployment", "queue", "post-deploy"],
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Mathias Grimm", "email": "mathiasgrimm@gmail.com"}],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {"psr-4": {"MathiasGrimm\\PostDeployHooks\\": "src/"}},
    "autoload-dev": {"psr-4": {"MathiasGrimm\\PostDeployHooks\\Tests\\": "tests/"}},
    "extra": {
        "laravel": {
            "providers": ["MathiasGrimm\\PostDeployHooks\\PostDeployHooksServiceProvider"]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:check": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"pestphp/pest-plugin": true}
    }
}
